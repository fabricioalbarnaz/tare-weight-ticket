PORT=3000
DB_PATH=./data/tare.sqlite
# Signs the Admin UI's session cookie. Required, at least 32 characters,
# no default — core-service refuses to start without it. Generate a fresh
# random value per install (don't reuse this placeholder or share one
# across PCs), e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters-long
# Built Admin UI (apps/admin-ui `vite build` output) that core-service
# serves directly in production. Optional override — defaults to the
# sibling apps/admin-ui/dist path (that's where the Docker image places
# it); leave unset for local dev, where the Admin UI runs on its own Vite
# dev server instead.
#ADMIN_UI_DIR=../admin-ui/dist

# Digi-Tron Isis New scale indicator. core-service always speaks plain TCP
# here (SCALE_HOST/SCALE_PORT) — in production that TCP endpoint is
# apps/scale-bridge, a native process (outside Docker, like the print
# bridge) that owns the physical COM port and relays raw bytes over TCP.
# See docs/runbooks/isis-new-serial-setup.md. Everything here (byte-level
# protocol, stability rule) is still a documented provisional assumption,
# not a vendor-confirmed spec.
#
# IMPORTANT: this must be `host.docker.internal`, not `127.0.0.1`, whenever
# core-service runs inside the Docker container (the documented production
# setup) — 127.0.0.1 inside the container is the container's own loopback,
# not the Windows host where scale-bridge actually listens. Confirmed
# on-site (2026-10-24): with 127.0.0.1 the admin status panel shows the
# scale as permanently unreachable even with a real scale wired up and
# scale-bridge running; host.docker.internal is Docker Desktop's built-in
# DNS name for the host and needs no extra_hosts entry on Windows/WSL2.
# Only use 127.0.0.1 if you ever run core-service natively (e.g. `npm run
# dev`) instead of in the container.
SCALE_HOST=host.docker.internal
SCALE_PORT=9000
SCALE_STABILITY_TIMEOUT_MS=15000
SCALE_CONNECT_TIMEOUT_MS=5000
# Consecutive matching, spaced-apart DGN readings required before a weight
# counts as stable, and the minimum spacing between them (ms) — see
# apps/core-service/src/scale/dgn-frame-parser.ts.
SCALE_STABILITY_READING_COUNT=3
SCALE_STABILITY_SAMPLE_INTERVAL_MS=2000

# Scale bridge (apps/scale-bridge, a native process outside Docker — same
# reason as the print bridge: USB/COM-port access from Docker on Windows is
# unreliable). SCALE_BRIDGE_RELAY_PORT should match SCALE_PORT above.
SCALE_BRIDGE_COM_PORT=COM3
SCALE_BRIDGE_BAUD_RATE=9600
SCALE_BRIDGE_RELAY_PORT=9000
SCALE_BRIDGE_HEALTH_PORT=4100

# Camera readings arriving within this window (ms) after the most recently
# closed ticket's exitAt are discarded, whatever plate they report — guards
# against a released truck rolling back and re-triggering a camera. See
# docs/plans/2026-11-03-camera-post-release-debounce-plan.md. Default 15000.
#CAMERA_POST_RELEASE_DEBOUNCE_MS=15000

# An exit reading with no OPEN ticket for its plate, arriving within this
# window (ms) after that same plate's most recently CLOSED ticket's exitAt,
# is treated as a re-weigh correction (reuses that ticket's entry
# weight/time, creates a new linked ticket) instead of being flagged
# ANOMALY. See docs/plans/2026-11-12-exit-reweigh-plan.md and master plan
# §5/§11. Default 7200000 (2h).
#EXIT_REWEIGH_WINDOW_MS=7200000

# Driver signal ("move on" signal to the truck driver). Two adapters:
# - "http-relay" (default): a plain HTTP call to a standalone network relay
#   (e.g. Shelly/Tasmota-style). Real hardware not chosen yet (see
#   docs/plans master plan §7.4) — leave a URL unset to disable that
#   direction (no-op) until hardware is confirmed.
# - "hikvision-isapi": fires the entrance/exit ANPR camera's own dedicated
#   PUT /ISAPI/Parking/channels/<id>/barrierGate endpoint instead of a
#   separate relay box. On this install the camera's relay drives an
#   audible siren, not an actual barrier gate — see
#   docs/runbooks/hikvision-tcg406-relay-findings.md and
#   docs/plans/2026-11-04-hikvision-barriergate-endpoint-fix-plan.md.
#   Which ctrlMode ("open" = relay 1, "close" = relay 2) actually drives
#   the siren is still unconfirmed on-site.
DRIVER_SIGNAL_ADAPTER=http-relay
#DRIVER_SIGNAL_URL_ENTRANCE=http://relay.local/entrance
#DRIVER_SIGNAL_URL_EXIT=http://relay.local/exit
DRIVER_SIGNAL_TIMEOUT_MS=3000

# Only read when DRIVER_SIGNAL_ADAPTER=hikvision-isapi. username/password
# are required once the camera's URL is set for a direction — hardware
# placeholders, confirm on-site (camera admin credentials). CHANNEL_ID
# defaults to "1" and CTRL_MODE to "open" (relay 1) if unset — change
# CTRL_MODE to "close" to fire relay 2 instead, once on-site testing
# confirms which relay the siren is actually wired to.
#DRIVER_SIGNAL_HIKVISION_ENTRANCE_URL=http://192.168.1.10
#DRIVER_SIGNAL_HIKVISION_ENTRANCE_CHANNEL_ID=1
#DRIVER_SIGNAL_HIKVISION_ENTRANCE_CTRL_MODE=open
#DRIVER_SIGNAL_HIKVISION_ENTRANCE_USERNAME=admin
#DRIVER_SIGNAL_HIKVISION_ENTRANCE_PASSWORD=change-me
#DRIVER_SIGNAL_HIKVISION_EXIT_URL=http://192.168.1.11
#DRIVER_SIGNAL_HIKVISION_EXIT_CHANNEL_ID=1
#DRIVER_SIGNAL_HIKVISION_EXIT_CTRL_MODE=open
#DRIVER_SIGNAL_HIKVISION_EXIT_USERNAME=admin
#DRIVER_SIGNAL_HIKVISION_EXIT_PASSWORD=change-me

# Print bridge (apps/print-bridge, a native process outside Docker — see
# docs/plans master plan §7.1). Same host.docker.internal note as
# SCALE_HOST above applies here: this is an HTTP call from inside the
# core-service container to a native Windows process, so 127.0.0.1 would
# resolve to the container itself.
PRINT_BRIDGE_URL=http://host.docker.internal:4000
PRINT_BRIDGE_PORT=4000

# print-bridge's own PrinterTransport selection (read directly from
# process.env by apps/print-bridge — not forwarded by core-service).
# "file" (default) writes each job to PRINT_BRIDGE_OUTPUT_DIR instead of a
# real printer — useful with no printer hardware available yet. "network"
# sends raw ESC/POS bytes over TCP to a network-attached thermal printer's
# RAW/JetDirect port (conventionally 9100) — confirmed on-site 2026-10-24
# against an installed POS80 network printer (check Windows' own `Get-
# Printer` output or the printer's admin page for its real IP; don't
# assume USB). PRINTER_NETWORK_HOST/PORT are only read when
# PRINTER_TRANSPORT=network.
PRINTER_TRANSPORT=file
#PRINTER_NETWORK_HOST=192.168.1.50
#PRINTER_NETWORK_PORT=9100
#PRINTER_CONNECT_TIMEOUT_MS=5000
PRINT_BRIDGE_OUTPUT_DIR=./print-jobs
